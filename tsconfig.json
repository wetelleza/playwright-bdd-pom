{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022", "DOM"],
    "moduleResolution": "node",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@pages/*": ["pages/*"],
      "@support/*": ["support/*"]
    },
    "outDir": "dist"
  },
  "include": ["pages/**/*.ts", "steps/**/*.ts", "support/**/*.ts", "ai/**/*.ts", "report/**/*.ts", "clients/**/*.ts", "api-server/src/**/*.ts", "playwright.config.ts", ".features-gen/**/*.ts"],
  "exclude": ["node_modules", "dist", "playwright-report", "test-results"]
}
